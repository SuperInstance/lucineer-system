library(ternary_rom_generic_180nm) {
  technology (cmos) ;
  delay_model : generic_cmos ;
  time_unit : "1ns" ;
  voltage_unit : "1V" ;
  capacitive_load_unit (1.0, pf) ;
  leakage_power_unit : "1pW" ;

  default_operating_conditions (nom) {
    voltage : 5.00 ;
  }

  lu_table_template(delay_template_1x1) {
    variable_1 : input_net_transition ;
    variable_2 : total_output_net_capacitance ;
    index_1 ("0.010") ;
    index_2 ("0.020") ;
  }

  cell (ROM_PLUS_X1) {
    area : 4.000000 ;
    cell_leakage_power : 8000.000000 ;
    // Drive: X1, Vt: std

    pin (WL) {
      direction : input ;
      capacitance : 0.500 ;
    }

    pin (BL) {
      direction : output ;
      max_capacitance : 0.500 ;
      timing () {
        related_pin : "WL" ;
        timing_sense : positive_unate ;

        cell_rise (delay_template_1x1) {
          values ("8.0000") ;
        }
        rise_transition (delay_template_1x1) {
          values ("0.1000") ;
        }
        cell_fall (delay_template_1x1) {
          values ("0.0000") ;
        }
        fall_transition (delay_template_1x1) {
          values ("0.0000") ;
        }
      }
    }
  }

  cell (ROM_MINUS_X1) {
    area : 4.000000 ;
    cell_leakage_power : 8000.000000 ;
    // Drive: X1, Vt: std

    pin (WL) {
      direction : input ;
      capacitance : 0.500 ;
    }

    pin (BL) {
      direction : output ;
      max_capacitance : 0.500 ;
      timing () {
        related_pin : "WL" ;
        timing_sense : negative_unate ;

        cell_rise (delay_template_1x1) {
          values ("0.0000") ;
        }
        rise_transition (delay_template_1x1) {
          values ("0.0000") ;
        }
        cell_fall (delay_template_1x1) {
          values ("8.0000") ;
        }
        fall_transition (delay_template_1x1) {
          values ("0.1000") ;
        }
      }
    }
  }

  cell (ROM_ZERO_X1) {
    area : 4.000000 ;
    cell_leakage_power : 0.000000 ;
    // Drive: X1, Vt: std

    pin (WL) {
      direction : input ;
      capacitance : 0.500 ;
    }

    pin (BL) {
      direction : output ;
      max_capacitance : 0.500 ;
    }
  }

  cell (ROM_REF_HI) {
    area : 4.000000 ;
    cell_leakage_power : 8000.000000 ;
    // Drive: X1, Vt: std

    pin (WL) {
      direction : input ;
      capacitance : 0.500 ;
    }

    pin (BL) {
      direction : output ;
      max_capacitance : 0.500 ;
      timing () {
        related_pin : "WL" ;
        timing_sense : positive_unate ;

        cell_rise (delay_template_1x1) {
          values ("8.0000") ;
        }
        rise_transition (delay_template_1x1) {
          values ("0.1000") ;
        }
        cell_fall (delay_template_1x1) {
          values ("0.0000") ;
        }
        fall_transition (delay_template_1x1) {
          values ("0.0000") ;
        }
      }
    }
  }

  cell (ROM_REF_LO) {
    area : 4.000000 ;
    cell_leakage_power : 8000.000000 ;
    // Drive: X1, Vt: std

    pin (WL) {
      direction : input ;
      capacitance : 0.500 ;
    }

    pin (BL) {
      direction : output ;
      max_capacitance : 0.500 ;
      timing () {
        related_pin : "WL" ;
        timing_sense : negative_unate ;

        cell_rise (delay_template_1x1) {
          values ("0.0000") ;
        }
        rise_transition (delay_template_1x1) {
          values ("0.0000") ;
        }
        cell_fall (delay_template_1x1) {
          values ("8.0000") ;
        }
        fall_transition (delay_template_1x1) {
          values ("0.1000") ;
        }
      }
    }
  }

}
