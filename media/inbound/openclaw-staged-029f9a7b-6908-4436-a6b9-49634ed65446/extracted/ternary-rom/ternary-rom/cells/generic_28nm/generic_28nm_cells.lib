library(ternary_rom_generic_28nm) {
  technology (cmos) ;
  delay_model : generic_cmos ;
  time_unit : "1ns" ;
  voltage_unit : "1V" ;
  capacitive_load_unit (1.0, pf) ;
  leakage_power_unit : "1pW" ;

  default_operating_conditions (nom) {
    voltage : 1.0 ;
  }

  lu_table_template(delay_template_1x1) {
    variable_1 : input_net_transition ;
    variable_2 : total_output_net_capacitance ;
    index_1 ("0.010") ;
    index_2 ("0.020") ;
  }

  cell (ROM_PLUS_X1) {
    area : 0.0484 ;
    cell_leakage_power : 2.3700 ;

    pin (WL) {
      direction : input ;
      capacitance : 0.500 ;
    }

    pin (BL) {
      direction : output ;
      max_capacitance : 0.500 ;
      timing () {
        related_pin : "WL" ;
        timing_sense : positive_unate ;

        cell_rise (delay_template_1x1) {
          values ("0.500") ;
        }
        rise_transition (delay_template_1x1) {
          values ("0.100") ;
        }
        cell_fall (delay_template_1x1) {
          values ("0.000") ;
        }
        fall_transition (delay_template_1x1) {
          values ("0.000") ;
        }
      }
    }
  }

  cell (ROM_MINUS_X1) {
    area : 0.0484 ;
    cell_leakage_power : 2.3700 ;

    pin (WL) {
      direction : input ;
      capacitance : 0.500 ;
    }

    pin (BL) {
      direction : output ;
      max_capacitance : 0.500 ;
      timing () {
        related_pin : "WL" ;
        timing_sense : negative_unate ;

        cell_rise (delay_template_1x1) {
          values ("0.000") ;
        }
        rise_transition (delay_template_1x1) {
          values ("0.000") ;
        }
        cell_fall (delay_template_1x1) {
          values ("0.500") ;
        }
        fall_transition (delay_template_1x1) {
          values ("0.100") ;
        }
      }
    }
  }

  cell (ROM_ZERO_X1) {
    area : 0.0484 ;
    cell_leakage_power : 0.0000 ;

    pin (WL) {
      direction : input ;
      capacitance : 0.500 ;
    }

    pin (BL) {
      direction : output ;
      max_capacitance : 0.500 ;
    }
  }

}
