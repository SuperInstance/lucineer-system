    }

    pin (BL) {
      direction : output ;
      max_capacitance : 0.500 ;
      timing () {
        related_pin : "WL" ;
        timing_sense : positive_unate ;

        cell_rise (delay_template_1x1) {
          values ("2.0000") ;
        }
        rise_transition (delay_template_1x1) {
          values ("0.1000") ;
        }
        cell_fall (delay_template_1x1) {
          values ("0.0000") ;
        }
        fall_transition (delay_template_1x1) {
          values ("0.0000") ;
