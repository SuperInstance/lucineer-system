library(ternary_rom_ihp130_sige) {
  technology (cmos) ;
  delay_model : generic_cmos ;
  time_unit : "1ns" ;
  voltage_unit : "1V" ;
  capacitive_load_unit (1.0, pf) ;
  leakage_power_unit : "1pW" ;

  default_operating_conditions (nom) {
    voltage : 3.30 ;
  }

  lu_table_template(delay_template_1x1) {
    variable_1 : input_net_transition ;
    variable_2 : total_output_net_capacitance ;
    index_1 ("0.010") ;
    index_2 ("0.020") ;
  }

  cell (ROM_PLUS_X1_lvt) {
    area : 1.210000 ;
    cell_leakage_power : 99.000000 ;
    // Drive: X1, Vt: lvt

    pin (WL) {
      direction : input ;
      capacitance : 0.500 ;
    }

    pin (BL) {
      direction : output ;
      max_capacitance : 0.500 ;
      timing () {
        related_pin : "WL" ;
        timing_sense : positive_unate ;

        cell_rise (delay_template_1x1) {
          values ("1.6000") ;
        }
        rise_transition (delay_template_1x1) {
          values ("0.1000") ;
        }
        cell_fall (delay_template_1x1) {
          values ("0.0000") ;
        }
        fall_transition (delay_template_1x1) {
          values ("0.0000") ;
        }
      }
    }
  }

  cell (ROM_PLUS_X1) {
    area : 1.210000 ;
    cell_leakage_power : 33.000000 ;
    // Drive: X1, Vt: std

    pin (WL) {
      direction : input ;
      capacitance : 0.500 ;
    }

    pin (BL) {
      direction : output ;
      max_capacitance : 0.500 ;
      timing () {
        related_pin : "WL" ;
        timing_sense : positive_unate ;

        cell_rise (delay_template_1x1) {
          values ("2.0000") ;
        }
        rise_transition (delay_template_1x1) {
          values ("0.1000") ;
        }
        cell_fall (delay_template_1x1) {
          values ("0.0000") ;
        }
        fall_transition (delay_template_1x1) {
          values ("0.0000") ;
        }
      }
    }
  }

  cell (ROM_PLUS_X2_lvt) {
    area : 2.420000 ;
    cell_leakage_power : 198.000000 ;
    // Drive: X2, Vt: lvt

    pin (WL) {
      direction : input ;
      capacitance : 1.000 ;
    }

    pin (BL) {
      direction : output ;
      max_capacitance : 0.500 ;
      timing () {
        related_pin : "WL" ;
        timing_sense : positive_unate ;

        cell_rise (delay_template_1x1) {
          values ("1.0400") ;
        }
        rise_transition (delay_template_1x1) {
          values ("0.0500") ;
        }
        cell_fall (delay_template_1x1) {
          values ("0.0000") ;
        }
        fall_transition (delay_template_1x1) {
          values ("0.0000") ;
        }
      }
    }
  }

  cell (ROM_PLUS_X2) {
    area : 2.420000 ;
    cell_leakage_power : 66.000000 ;
    // Drive: X2, Vt: std

    pin (WL) {
      direction : input ;
      capacitance : 1.000 ;
    }

    pin (BL) {
      direction : output ;
      max_capacitance : 0.500 ;
