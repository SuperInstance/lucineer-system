    }

    pin (BL) {
      direction : output ;
      max_capacitance : 0.500 ;
      timing () {
        related_pin : "WL" ;
        timing_sense : negative_unate ;

        cell_rise (delay_template_1x1) {
          values ("0.0000") ;
        }
        rise_transition (delay_template_1x1) {
          values ("0.0000") ;
        }
        cell_fall (delay_template_1x1) {
          values ("1.6000") ;
        }
        fall_transition (delay_template_1x1) {
          values ("0.1000") ;
        }
      }
    }
  }

  cell (ROM_MINUS_X1) {
    area : 1.210000 ;
