library(ternary_rom_samsung11_lpp) {
  technology (cmos) ;
  delay_model : generic_cmos ;
  time_unit : "1ns" ;
  voltage_unit : "1V" ;
  capacitive_load_unit (1.0, pf) ;
  leakage_power_unit : "1pW" ;

  default_operating_conditions (nom) {
    voltage : 0.75 ;
  }

  lu_table_template(delay_template_1x1) {
    variable_1 : input_net_transition ;
    variable_2 : total_output_net_capacitance ;
    index_1 ("0.010") ;
    index_2 ("0.020") ;
  }

  cell (ROM_PLUS_X1_hvt) {
    area : 0.004900 ;
    cell_leakage_power : 0.045000 ;
    // Drive: X1, Vt: hvt

    pin (WL) {
      direction : input ;
      capacitance : 0.500 ;
    }

    pin (BL) {
      direction : output ;
      max_capacitance : 0.500 ;
      timing () {
        related_pin : "WL" ;
        timing_sense : positive_unate ;

        cell_rise (delay_template_1x1) {
          values ("0.1040") ;
        }
        rise_transition (delay_template_1x1) {
          values ("0.1000") ;
        }
        cell_fall (delay_template_1x1) {
          values ("0.0000") ;
        }
        fall_transition (delay_template_1x1) {
          values ("0.0000") ;
        }
      }
    }
  }

